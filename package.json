    "test:testset": "node scripts/eval/check-testset.mjs",
    "eval:run": "node eval/run.mjs",
    "content:placeholders": "node scripts/content/check-placeholders.mjs",
    "review:scholar-packet": "node scripts/review/scholar-packet.mjs",
