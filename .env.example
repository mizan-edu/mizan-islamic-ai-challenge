# Names only — never commit values (R10). Copy to .env.local (git-ignored) and fill in locally;
# on Vercel, set the same names under Project Settings -> Environment Variables.

# Anthropic API key. Console user keys start with sk-ant-usr- and need ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
# Workspace ID (wrkspc_...) sent as the anthropic-workspace-id header; leave empty for workspace-scoped keys.
ANTHROPIC_WORKSPACE_ID=

# Model classifier (fallback only). Provider "anthropic"; model ID from the Saturday spike, never hard-coded.
LLM_PROVIDER=
LLM_MODEL=
# Optional: low | medium | high.
LLM_EFFORT=
# Optional: "on" lets the model rephrase NA science/UI lines; anything else keeps the approved wording.
LLM_REPHRASE=

# Classifier fallback (A4, D42): OpenAI as the secondary provider. Both must be set to enable it;
# otherwise a failed primary goes straight to the static tier (the station's approved fallback).
OPENAI_API_KEY=
LLM_FALLBACK_MODEL=
# Optional reasoning_effort for the secondary model.
LLM_FALLBACK_EFFORT=
# Local evidence runs only: "1" makes the primary fail every call. Ignored on Vercel; never set it there.
FORCE_PRIMARY_FAIL=

# Narration generator only (npm run assets:narrate; pre-build tooling, never called at runtime).
ELEVENLABS_API_KEY=
