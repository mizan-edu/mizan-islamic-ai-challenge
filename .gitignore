# .env.example lists variable names only and is committed
!.env.example

# Playwright artefacts (screenshots kept in docs/screenshots)
/test-results/
/playwright-report/

# A2 baseline raw outputs (D51): local only, never committed; deleted after the summary.
eval/.a2-raw/

# Local preview server config for Claude Code (not part of the app).
.claude/launch.json

# Video inputs for Higgsfield image-to-video (D60): local working copies of approved pictures, not shipped.
docs/video-input/

# Second takes of the sound effects (D65): local alternatives, not shipped.
docs/sfx-alt/
# Original take-1 sound files with their intact C2PA content credentials (D65); shipped copies are gain-normalised.
docs/sfx-originals/

# Unpublished drafts for review (D69): never committed.
docs/drafts/
